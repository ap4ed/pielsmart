---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pillarSlug = 'dispositivos';
const pillarName = 'Dispositivos';
const pillarColor = '#5E9EC4';
const pillarIntro = 'Reseñas y comparativas de dispositivos de belleza: secadoras de pelo, planchas para alisar y herramientas de estilismo profesional. Análisis técnico con precios reales en Amazon para toda América Latina.';

const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.pillar === pillarSlug)
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('es-419', { day: 'numeric', month: 'long', year: 'numeric' });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pielsmart.com/' },
    { '@type': 'ListItem', position: 2, name: pillarName, item: `https://pielsmart.com/${pillarSlug}/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${pillarName} — PielSmart`,
  url: `https://pielsmart.com/${pillarSlug}/`,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://pielsmart.com/${pillarSlug}/${a.id}/`,
    name: a.data.title,
  })),
};
---

<BaseLayout
  title="Mejores Dispositivos de Belleza 2026 — PielSmart"
  description="Las mejores secadoras, planchas y rizadoras de 2026: Dyson, Revlon, Shark y más. Comparativas técnicas con precios reales en Amazon para toda América Latina."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <div class="pillar-header-band" style={`border-top: 4px solid ${pillarColor}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <span>{pillarName}</span>
    </nav>
    <h1 class="pillar-h1">{pillarName}</h1>
    <p class="pillar-intro">{pillarIntro}</p>
  </div>

  {articles.length === 0 ? (
    <p class="empty">Artículos en camino — vuelve pronto.</p>
  ) : (
    <>
      <a href={`/${pillarSlug}/${articles[0].id}/`} class="featured-article">
        {articles[0].data.image && (
          <div class="featured-img">
            <img
              src={`${articles[0].data.image}?auto=compress&cs=tinysrgb&w=900&h=460&fit=crop`}
              alt={articles[0].data.title}
              loading="eager"
            />
          </div>
        )}
        <div class="featured-body">
          <span class="featured-label" style={`color:${pillarColor}`}>{pillarName}</span>
          <h2 class="featured-title">{articles[0].data.title}</h2>
          <p class="featured-desc">{articles[0].data.description}</p>
          <div class="featured-meta">
            <span class="featured-date">{formatDate(articles[0].data.datePublished)}</span>
            <span class="featured-cta" style={`color:${pillarColor}`}>Leer artículo →</span>
          </div>
        </div>
      </a>

      {articles.slice(1).length > 0 && (
        <>
          <hr class="divider" />
          <div class="article-grid">
            {articles.slice(1).map(article => (
              <a href={`/${pillarSlug}/${article.id}/`} class="article-card">
                {article.data.image && (
                  <div class="card-img-wrap">
                    <img
                      src={`${article.data.image}?auto=compress&cs=tinysrgb&w=600&h=340&fit=crop`}
                      alt={article.data.title}
                      class="card-img"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="card-body">
                  <div class="card-meta">
                    <span class="date">{formatDate(article.data.datePublished)}</span>
                  </div>
                  <h2 class="card-title">{article.data.title}</h2>
                  <p class="card-desc">{article.data.description}</p>
                  <span class="card-link" style={`color:${pillarColor}`}>Leer artículo →</span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </>
  )}
</BaseLayout>

<style>
.pillar-header-band {
  padding-top: 2rem;
  margin-bottom: 2rem;
}
.featured-article {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem;
  align-items: center;
  text-decoration: none;
  color: inherit;
  margin-bottom: 2.5rem;
}
.featured-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 8px;
}
.featured-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
.featured-article:hover .featured-img img { transform: scale(1.03); }
.featured-body { display: flex; flex-direction: column; gap: 0.6rem; }
.featured-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; font-family: 'DM Sans', sans-serif; }
.featured-title { font-size: clamp(1.3rem, 2.5vw, 1.9rem); font-family: 'Playfair Display', Georgia, serif; font-weight: 700; color: #111; margin: 0; line-height: 1.2; }
.featured-article:hover .featured-title { color: #c4693a; }
.featured-desc { font-size: 0.95rem; color: #555; line-height: 1.7; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.featured-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.25rem; }
.featured-date { font-size: 0.78rem; color: #aaa; font-family: 'DM Sans', sans-serif; }
.featured-cta { font-size: 0.85rem; font-weight: 600; font-family: 'DM Sans', sans-serif; white-space: nowrap; }
@media (max-width: 700px) { .featured-article { grid-template-columns: 1fr; gap: 1.25rem; } }
.breadcrumb {
  font-size: 0.875rem;
  color: #999;
  margin: 0 0 1.5rem;
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.breadcrumb a { color: #999; text-decoration: none; }
.breadcrumb a:hover { color: #c4693a; }
.pillar-h1 {
  font-size: clamp(2rem, 4vw, 3rem);
  margin: 0 0 0.75rem;
  color: #1a1a2e;
}
.pillar-intro {
  font-size: 1.05rem;
  color: #4b5563;
  line-height: 1.75;
  max-width: 720px;
  margin: 0 0 1.5rem;
}
.divider {
  border: none;
  border-top: 1px solid #e8e8e8;
  margin: 0 0 2.5rem;
}
.empty {
  color: #999;
  font-size: 1rem;
  padding: 3rem 0;
}
.article-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 3rem;
}
@media (max-width: 768px) { .article-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .article-grid { grid-template-columns: 1fr; } }
.article-card {
  display: flex;
  flex-direction: column;
  border: 1px solid #e8e8e8;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s, border-color 0.2s;
}
.article-card:hover {
  box-shadow: 0 6px 20px rgba(0,0,0,0.09);
  border-color: #ccc;
}
.card-img-wrap { width: 100%; height: 200px; overflow: hidden; }
.card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
.article-card:hover .card-img { transform: scale(1.04); }
.card-body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; }
.card-meta { margin-bottom: 0.6rem; }
.date { font-size: 0.8rem; color: #999; }
.card-title { font-size: 1.05rem; margin: 0 0 0.6rem; line-height: 1.3; color: #1a1a2e; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-desc { font-size: 0.875rem; color: #5a5a6e; margin: 0 0 1rem; line-height: 1.6; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-link { font-size: 0.875rem; font-weight: 600; margin-top: auto; }
</style>
