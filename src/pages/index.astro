---
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  {
    slug: 'skincare',
    nombre: 'Skincare',
    descripcion: 'Retinol, ácido hialurónico, serum, protector solar y más',
    emoji: '🧴',
  },
  {
    slug: 'maquillaje',
    nombre: 'Maquillaje',
    descripcion: 'Base, labial, mascara, iluminador, bb cream y todo lo que necesitas',
    emoji: '💄',
  },
  {
    slug: 'cabello',
    nombre: 'Cabello',
    descripcion: 'Shampoo, planchas, rizadores, tinte y tratamientos capilares',
    emoji: '💇',
  },
  {
    slug: 'unas',
    nombre: 'Uñas',
    descripcion: 'Diseños de uñas acrílicas, de gel, esmaltes y más tendencias',
    emoji: '💅',
  },
  {
    slug: 'perfumes',
    nombre: 'Perfumes',
    descripcion: 'Los mejores perfumes de mujer y hombre, colonias y fragancias',
    emoji: '🌸',
  },
  {
    slug: 'dispositivos',
    nombre: 'Dispositivos',
    descripcion: 'Aparatos de belleza: mascarillas LED, microcorriente, limpieza facial',
    emoji: '✨',
  },
];
---

<BaseLayout
  title="PielSmart — Tu guía de belleza en español"
  description="Reseñas, guías y comparativas de skincare, maquillaje, cabello, uñas, perfumes y más — todo en español, con precios en Amazon."
>
  <section class="hero">
    <h1>Tu guía de belleza en español</h1>
    <p class="hero-sub">
      Reseñas, guías y comparativas de skincare, maquillaje, cabello, uñas, perfumes y más — todo en español, con precios en Amazon.
    </p>
  </section>

  <section class="pillars">
    <h2>Explora por categoría</h2>
    <div class="pillar-grid">
      {pillars.map(({ slug, nombre, descripcion, emoji }) => (
        <a href={`/${slug}/`} class="pillar-card">
          <span class="emoji">{emoji}</span>
          <h3>{nombre}</h3>
          <p>{descripcion}</p>
          <span class="ver-mas">Ver artículos →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="por-que">
    <h2>¿Por qué confiar en PielSmart?</h2>
    <div class="razones">
      <div class="razon">
        <strong>Experiencia real de retail</strong>
        <p>Operamos NAZ Beauty Shop en Panamá. Compramos, vendemos y probamos estas marcas con clientes reales — no somos un blog que solo lee manuales.</p>
      </div>
      <div class="razon">
        <strong>Picks decisivos, no listas interminables</strong>
        <p>Por categoría te decimos cuál comprar y por qué. Sin listas de 20 productos que no ayudan a nadie.</p>
      </div>
      <div class="razon">
        <strong>Para LATAM, en español de verdad</strong>
        <p>Precios en USD (funciona para compradores en toda América Latina vía Amazon US). Español latinoamericano, sin traducciones genéricas.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
    max-width: 760px;
    margin: 0 auto;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: #4b5563;
    line-height: 1.8;
  }

  .pillars { margin: 3rem 0; }
  .pillars h2 { margin-bottom: 1.5rem; }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }
  .pillar-card {
    display: block;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .pillar-card:hover {
    border-color: #e07b39;
    box-shadow: 0 4px 12px rgba(224, 123, 57, 0.12);
  }
  .pillar-card .emoji { font-size: 2rem; display: block; margin-bottom: 0.75rem; }
  .pillar-card h3 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .pillar-card p { margin: 0 0 1rem; font-size: 0.9rem; color: #4b5563; line-height: 1.6; }
  .ver-mas { font-size: 0.9rem; font-weight: 600; color: #e07b39; }

  .por-que { margin: 3rem 0; }
  .por-que h2 { margin-bottom: 1.5rem; }
  .razones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .razon {
    background: #f9fafb;
    border-radius: 8px;
    padding: 1.25rem;
  }
  .razon strong { display: block; margin-bottom: 0.5rem; font-size: 1rem; }
  .razon p { margin: 0; font-size: 0.9rem; color: #4b5563; line-height: 1.6; }
</style>
