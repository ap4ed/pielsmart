</style>

{/* ── Article data + finder logic ── */}
<script define:vars={{ articlesJson }}>
  window.__PS_ARTICLES__ = JSON.parse(articlesJson);

  const PILLAR_NAMES = {
    skincare: 'Skincare', maquillaje: 'Maquillaje', cabello: 'Cabello',
    unas: 'Uñas', perfumes: 'Perfumes', dispositivos: 'Dispositivos'
  };

  function normalize(s) {
    return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  const STOP = new Set('el la los las un una unos unas de del en con para por sin a al me mi mis yo tu te su necesito quiero busco tengo hay es son ser usar utilizar cual cuales como que donde muy mas tanto poco mucho algo mejor mejores bueno buena buenos buenas buen hacer quitar poner aplicar conseguir comprar recomiendas recomienda recomiendo recomiendan probaste probar quito quitas tienes tienen pongo pones ponerse debo deberia'.split(' '));

  function search(q, articles) {
    if (!q || q.trim().length < 2) return [];
    const terms = normalize(q.trim()).split(/\s+/).filter(t => t.length > 1 && !STOP.has(t));
    if (terms.length === 0) return [];
    return articles.filter(a => {
      const hay = normalize(a.title + ' ' + a.description + ' ' + a.pillar + ' ' + (a.keyword || '') + ' ' + (a.tags || ''));
      return terms.every(t => hay.includes(t));
    }).slice(0, 6);
  }

  function renderResults(items, container) {
    if (items.length === 0) {
      container.innerHTML = '<p class="fr-empty">Sin resultados — prueba con otras palabras.</p>';
    } else {
      container.innerHTML = `<div class="fr-grid">${items.map(a => `
        <a href="/${a.pillar}/${a.id}/" class="fr-item">
          ${a.image ? `<div class="fr-thumb"><img src="${a.image}?auto=compress&cs=tinysrgb&w=120&h=90&fit=crop" alt="" loading="lazy"/></div>` : ''}
          <div class="fr-body">
            <span class="fr-label">${PILLAR_NAMES[a.pillar] || a.pillar}</span>
            <div class="fr-title">${a.title}</div>
          </div>
        </a>
      `).join('')}</div>`;
    }
    container.hidden = false;
  }

  const articles = window.__PS_ARTICLES__;
  const finderInput = document.getElementById('finderInput');
  const finderResults = document.getElementById('finderResults');

  document.querySelectorAll('.finder-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.dataset.q || '';
      if (finderInput) { finderInput.value = q; finderInput.focus(); }
      renderResults(search(q, articles), finderResults);
    });
  });

  let debounce;
  if (finderInput) {
    finderInput.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = finderInput.value.trim();
      if (q.length < 2) { finderResults.hidden = true; return; }
      debounce = setTimeout(() => renderResults(search(q, articles), finderResults), 180);
    });
  }

  const urlQ = new URLSearchParams(location.search).get('q');
  if (urlQ && urlQ.trim().length >= 2) {
    if (finderInput) finderInput.value = urlQ;
    renderResults(search(urlQ, articles), finderResults);
    document.querySelector('.finder-section')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
</script>
