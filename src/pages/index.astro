---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PielSmart',
  url: 'https://pielsmart.com',
  description: 'Guías y reseñas de belleza en español para América Latina.',
  inLanguage: 'es-419',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://pielsmart.com/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PielSmart',
  url: 'https://pielsmart.com',
  logo: { '@type': 'ImageObject', url: 'https://pielsmart.com/favicon.svg' },
  description: 'Guías de belleza en español para América Latina — skincare, maquillaje, cabello, uñas, perfumes y dispositivos.',
  sameAs: ['https://github.com/ap4ed/pielsmart'],
};

const allArticles = await getCollection('articles');
allArticles.sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());

const featured = allArticles[0];
const second = allArticles[1];
const third = allArticles[2];

const pillarColors: Record<string, string> = {
  skincare: '#7DB9A8',
  maquillaje: '#C4728A',
  cabello: '#C9A35E',
  unas: '#9B7EC8',
  perfumes: '#C47898',
  dispositivos: '#5E9EC4',
};

const pillarNames: Record<string, string> = {
  skincare: 'Skincare',
  maquillaje: 'Maquillaje',
  cabello: 'Cabello',
  unas: 'Uñas',
  perfumes: 'Perfumes',
  dispositivos: 'Dispositivos',
};

// Group articles by pillar, preserving order of first appearance
const pillarOrder: string[] = [];
const byPillar = new Map<string, typeof allArticles>();
for (const article of allArticles) {
  const p = article.data.pillar;
  if (!byPillar.has(p)) {
    byPillar.set(p, []);
    pillarOrder.push(p);
  }
  byPillar.get(p)!.push(article);
}

const pillars = [
  { slug: 'skincare', nombre: 'Skincare' },
  { slug: 'maquillaje', nombre: 'Maquillaje' },
  { slug: 'cabello', nombre: 'Cabello' },
  { slug: 'unas', nombre: 'Uñas' },
  { slug: 'perfumes', nombre: 'Perfumes' },
  { slug: 'dispositivos', nombre: 'Dispositivos' },
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('es-419', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="PielSmart — Guías y reseñas de belleza en español"
  description="Guías, reseñas y comparativas de skincare, maquillaje, cabello, uñas y perfumes para América Latina."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </Fragment>

  {/* ── Asymmetric Hero ── */}
  {featured && (
    <div class="hero-grid">
      {/* Featured — left 2/3 */}
      <a href={`/${featured.data.pillar}/${featured.id}/`} class="hero-featured">
        {featured.data.image && (
          <div class="hero-featured-img">
            <img
              src={`${featured.data.image}?auto=compress&cs=tinysrgb&w=900&h=360&fit=crop`}
              alt={featured.data.title}
              loading="eager"
            />
          </div>
        )}
        <div class="hero-featured-body">
          <div class="hero-featured-meta">
            <span class="pill" style={`background:${pillarColors[featured.data.pillar]}28; color:${pillarColors[featured.data.pillar]}`}>
              {pillarNames[featured.data.pillar]}
            </span>
            <span class="meta-date">{formatDate(featured.data.datePublished)}</span>
          </div>
          <h1 class="hero-featured-title">{featured.data.title}</h1>
          <p class="hero-featured-desc">{featured.data.description}</p>
          <span class="hero-read">Leer artículo →</span>
        </div>
      </a>

      {/* Side column — right 1/3 */}
      <div class="hero-side">
        {second && (
          <a href={`/${second.data.pillar}/${second.id}/`} class="hero-side-card">
            {second.data.image && (
              <div class="hero-side-img">
                <img
                  src={`${second.data.image}?auto=compress&cs=tinysrgb&w=500&h=220&fit=crop`}
                  alt={second.data.title}
                  loading="eager"
                />
              </div>
            )}
            <div class="hero-side-body">
              <div class="side-meta">
                <span class="pill" style={`background:${pillarColors[second.data.pillar]}22; color:${pillarColors[second.data.pillar]}`}>
                  {pillarNames[second.data.pillar]}
                </span>
                <span class="meta-date">{formatDate(second.data.datePublished)}</span>
              </div>
              <p class="hero-side-title">{second.data.title}</p>
            </div>
          </a>
        )}
        {third && (
          <a href={`/${third.data.pillar}/${third.id}/`} class="hero-side-card">
            {third.data.image && (
              <div class="hero-side-img">
                <img
                  src={`${third.data.image}?auto=compress&cs=tinysrgb&w=500&h=220&fit=crop`}
                  alt={third.data.title}
                  loading="lazy"
                />
              </div>
            )}
            <div class="hero-side-body">
              <div class="side-meta">
                <span class="pill" style={`background:${pillarColors[third.data.pillar]}22; color:${pillarColors[third.data.pillar]}`}>
                  {pillarNames[third.data.pillar]}
                </span>
                <span class="meta-date">{formatDate(third.data.datePublished)}</span>
              </div>
              <p class="hero-side-title">{third.data.title}</p>
            </div>
          </a>
        )}
      </div>
    </div>
  )}

  {/* ── Per-Pillar Category Sections ── */}
  {pillarOrder.map(pillar => {
    const articles = (byPillar.get(pillar) ?? []).slice(0, 3);
    if (articles.length === 0) return null;
    return (
      <section class="cat-section">
        <div class="cat-header">
          <h2 class="cat-title">{pillarNames[pillar]}</h2>
          <a href={`/${pillar}/`} class="cat-more" style={`color:${pillarColors[pillar]}`}>ver todo →</a>
        </div>
        <div class="cat-grid" style={articles.length === 1 ? 'grid-template-columns: repeat(1, minmax(0, 380px))' : articles.length === 2 ? 'grid-template-columns: repeat(2, 1fr)' : ''}>
          {articles.map(article => (
            <a href={`/${article.data.pillar}/${article.id}/`} class="art-card">
              {article.data.image && (
                <div class="art-img-wrap">
                  <img
                    src={`${article.data.image}?auto=compress&cs=tinysrgb&w=600&h=300&fit=crop`}
                    alt={article.data.title}
                    class="art-img"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="art-body">
                <div class="art-meta">
                  <span class="pill" style={`background:${pillarColors[article.data.pillar]}22; color:${pillarColors[article.data.pillar]}`}>
                    {pillarNames[article.data.pillar]}
                  </span>
                  <span class="meta-date">{formatDate(article.data.datePublished)}</span>
                </div>
                <p class="art-title">{article.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  {/* ── Browse Nav ── */}
  <nav class="browse-nav" aria-label="Explorar categorías">
    <span class="browse-label">Explorar:</span>
    {pillars.map(({ slug, nombre }, i) => (
      <>
        <a href={`/${slug}/`} class="browse-link">{nombre}</a>
        {i < pillars.length - 1 && <span class="dot">·</span>}
      </>
    ))}
  </nav>
</BaseLayout>

<style>
/* ── Hero ── */
.hero-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 1.25rem;
  margin: 2.5rem 0 3.5rem;
  align-items: stretch;
}

.hero-featured {
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #1a1a2e;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s;
}
.hero-featured:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.18); }

.hero-featured-img {
  width: 100%;
  height: 300px;
  overflow: hidden;
  flex-shrink: 0;
}
.hero-featured-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s;
}
.hero-featured:hover .hero-featured-img img { transform: scale(1.03); }

.hero-featured-body {
  padding: 1.75rem 2rem 2rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.hero-featured-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.875rem;
}
.hero-featured-title {
  font-size: clamp(1.3rem, 2.5vw, 1.9rem);
  color: #fff;
  margin: 0 0 0.75rem;
  line-height: 1.2;
  font-family: 'Playfair Display', Georgia, serif;
}
.hero-featured-desc {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.72);
  margin: 0 0 1.25rem;
  line-height: 1.65;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hero-read {
  font-size: 0.875rem;
  font-weight: 700;
  color: #e07b39;
}

/* Side column */
.hero-side {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.hero-side-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  border: 1px solid #e8e8e8;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s;
  min-height: 0;
}
.hero-side-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
.hero-side-img {
  width: 100%;
  height: 150px;
  overflow: hidden;
  flex-shrink: 0;
}
.hero-side-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}
.hero-side-card:hover .hero-side-img img { transform: scale(1.04); }
.hero-side-body {
  padding: 0.875rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  flex: 1;
}
.side-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.hero-side-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: #1a1a2e;
  margin: 0;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: 'Playfair Display', Georgia, serif;
}

/* Shared pill + date */
.pill {
  display: inline-block;
  font-size: 0.67rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 0.18rem 0.55rem;
  border-radius: 100px;
  white-space: nowrap;
}
.meta-date {
  font-size: 0.75rem;
  color: #aaa;
  white-space: nowrap;
}

/* ── Category sections ── */
.cat-section { margin-bottom: 3rem; }

.cat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.25rem;
  padding-left: 0.875rem;
  border-left: 4px solid #1a1a2e;
}
.cat-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0;
  font-family: 'DM Sans', sans-serif;
  letter-spacing: 0.3px;
}
.cat-more {
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}
.cat-more:hover { text-decoration: underline; }

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

/* Article card */
.art-card {
  display: flex;
  flex-direction: column;
  border: 1px solid #e8e8e8;
  border-radius: 10px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s;
}
.art-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.09); }
.art-img-wrap { width: 100%; height: 160px; overflow: hidden; flex-shrink: 0; }
.art-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
.art-card:hover .art-img { transform: scale(1.04); }
.art-body { padding: 0.875rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
.art-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.art-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: #1a1a2e;
  margin: 0;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: 'Playfair Display', Georgia, serif;
}

/* ── Browse nav ── */
.browse-nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding: 2rem 0 1rem;
  border-top: 1px solid #e8e8e8;
  font-size: 0.9rem;
}
.browse-label { color: #999; font-weight: 500; }
.browse-link { color: #2d2d2d; text-decoration: none; font-weight: 500; }
.browse-link:hover { color: #c4693a; }
.dot { color: #ccc; }

/* ── Mobile ── */
@media (max-width: 768px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-side { flex-direction: row; }
  .hero-side-card { flex: 1; }
  .cat-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 520px) {
  .hero-side { flex-direction: column; }
  .cat-grid { grid-template-columns: 1fr; }
}
</style>
