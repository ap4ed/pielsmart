---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PielSmart',
  url: 'https://pielsmart.com',
  description: 'Guías y reseñas de belleza.',
  inLanguage: 'es-419',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://pielsmart.com/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};

const allArticles = await getCollection('articles');
allArticles.sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());

const pillarNames: Record<string, string> = {
  skincare: 'Skincare',
  maquillaje: 'Maquillaje',
  cabello: 'Cabello',
  unas: 'Uñas',
  perfumes: 'Perfumes',
  dispositivos: 'Dispositivos',
};

// Subcategory links per pillar → link to existing articles
const pillarSubcats: Record<string, { label: string; href: string }[]> = {
  skincare: [
    { label: 'Ácido Hialurónico', href: '/skincare/para-que-sirve-el-acido-hialuronico/' },
    { label: 'Retinol', href: '/skincare/para-que-sirve-el-retinol/' },
    { label: 'Crema Hidratante', href: '/skincare/crema-hidratante-cara/' },
    { label: 'Cremas Coreanas', href: '/skincare/cremas-coreanas/' },
  ],
  maquillaje: [
    { label: 'Paso a Paso', href: '/maquillaje/maquillaje-sencillo-paso-a-paso/' },
    { label: 'Base', href: '/maquillaje/base-de-maquillaje/' },
    { label: 'Correctores', href: '/maquillaje/correctores-de-maquillaje/' },
    { label: 'Máscaras', href: '/maquillaje/mascaras-de-pestanas/' },
    { label: 'Sombras', href: '/maquillaje/sombras-de-ojos/' },
    { label: 'Cejas', href: '/maquillaje/cejas-perfectas/' },
  ],
  cabello: [
    { label: 'Shampoos', href: '/cabello/mejores-shampoos/' },
    { label: 'Secadoras y Planchas', href: '/dispositivos/mejores-secadoras-y-planchas/' },
  ],
  unas: [
    { label: 'Gel', href: '/unas/unas-gel/' },
    { label: 'Acrílicas', href: '/unas/unas-de-acrilico-guia-completa/' },
    { label: 'Semipermanentes', href: '/unas/unas-semipermanentes/' },
    { label: 'Modelos', href: '/unas/modelos-de-unas-2025/' },
  ],
  perfumes: [
    { label: 'Mujer', href: '/perfumes/perfumes-para-mujer/' },
    { label: 'Hombre', href: '/perfumes/perfumes-para-hombre/' },
    { label: 'Árabes', href: '/perfumes/perfumes-arabes/' },
  ],
  dispositivos: [
    { label: 'Secadoras y Planchas', href: '/dispositivos/mejores-secadoras-y-planchas/' },
  ],
};

// Group by pillar
const pillarOrder: string[] = [];
const byPillar = new Map<string, typeof allArticles>();
for (const article of allArticles) {
  const p = article.data.pillar;
  if (!byPillar.has(p)) { byPillar.set(p, []); pillarOrder.push(p); }
  byPillar.get(p)!.push(article);
}

const topStory = allArticles[0];
const secondStory = allArticles[1];
const sidebarArticles = allArticles.slice(0, 8);
// Editorial section: articles 2-5
const editorialFeatured = allArticles[2];
const editorialList = allArticles.slice(3, 6);

// Deals sidebar — hardcoded discounted products
// Deals rendered client-side for daily rotation — see <script> below

const pillars = [
  { slug: 'skincare', nombre: 'Skincare' },
  { slug: 'maquillaje', nombre: 'Maquillaje' },
  { slug: 'cabello', nombre: 'Cabello' },
  { slug: 'unas', nombre: 'Uñas' },
  { slug: 'perfumes', nombre: 'Perfumes' },
  { slug: 'dispositivos', nombre: 'Dispositivos' },
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('es-419', { day: 'numeric', month: 'long', year: 'numeric' });
}

const articlesJson = JSON.stringify(allArticles.map(a => ({
  id: a.id,
  title: a.data.title,
  description: a.data.description,
  pillar: a.data.pillar,
  image: a.data.image ?? null,
  keyword: a.data.targetKeyword ?? '',
  tags: (a.data.tags ?? []).join(' '),
})));

const finderSuggestions = [
  { label: '¿Para qué sirve el ácido hialurónico?', q: 'ácido hialurónico' },
  { label: '¿Cuál es el mejor shampoo para cabello dañado?', q: 'shampoo cabello' },
  { label: '¿Cómo maquillarme paso a paso?', q: 'maquillaje paso a paso' },
  { label: '¿Qué perfumes árabes valen la pena?', q: 'perfumes árabes' },
];
---

<BaseLayout
  title="PielSmart — Guías y reseñas de belleza"
  description="Guías y reseñas de belleza para mujeres. Skincare, maquillaje, cabello, uñas y perfumes con precios reales en Amazon."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  {/* ── 3-column hero ── */}
  <div class="hero-grid">

    {/* LEFT: recent article list */}
    <aside class="hero-sidebar-left">
      <p class="sidebar-title">Lo último</p>
      <ul class="sidebar-list">
        {sidebarArticles.map(a => (
          <li>
            <a href={`/${a.data.pillar}/${a.id}/`} class="sidebar-link">
              <span class="sidebar-pillar">{pillarNames[a.data.pillar]}</span>
              {a.data.title}
            </a>
          </li>
        ))}
      </ul>
      <a href="/skincare/" class="sidebar-see-all">Ver todo →</a>
    </aside>

    {/* CENTER: two featured articles */}
    <div class="hero-center">
      {topStory && (
        <a href={`/${topStory.data.pillar}/${topStory.id}/`} class="hero-center-story">
          {topStory.data.image && (
            <div class="hero-center-img">
              <img
                src={`${topStory.data.image}?auto=compress&cs=tinysrgb&w=800&h=340&fit=crop`}
                alt={topStory.data.title}
                loading="eager"
              />
            </div>
          )}
          <div class="hero-center-body">
            <span class="hero-center-byline">PielSmart · {formatDate(topStory.data.datePublished)}</span>
            <h1 class="hero-center-title">{topStory.data.title}</h1>
            <p class="hero-center-desc">{topStory.data.description}</p>
          </div>
        </a>
      )}
      {secondStory && (
        <>
          <hr class="hero-center-divider" />
          <a href={`/${secondStory.data.pillar}/${secondStory.id}/`} class="hero-center-story hero-center-story--secondary">
            {secondStory.data.image && (
              <div class="hero-center-img">
                <img
                  src={`${secondStory.data.image}?auto=compress&cs=tinysrgb&w=800&h=340&fit=crop`}
                  alt={secondStory.data.title}
                  loading="lazy"
                />
              </div>
            )}
            <div class="hero-center-body">
              <span class="hero-center-byline">PielSmart · {formatDate(secondStory.data.datePublished)}</span>
              <h2 class="hero-center-title hero-center-title--sm">{secondStory.data.title}</h2>
            </div>
          </a>
        </>
      )}
    </div>

    {/* RIGHT: deals sidebar */}
    <aside class="hero-sidebar-right">
      <p class="sidebar-title">Ofertas del día</p>
      <ul class="deals-list" id="dealsList"></ul>
      <a href="/perfumes/perfumes-arabes/" class="sidebar-see-all">Ver todas las ofertas →</a>
    </aside>

  </div>

  <hr class="hero-divider" />

  {/* ── Finder section ── */}
  <section class="finder-section" aria-label="Buscador de belleza">
    <div class="finder-body">
      <div class="finder-copy">
        <h2 class="finder-headline">¿Qué necesitas encontrar?</h2>
        <p class="finder-sub">PielSmart analiza cientos de productos para ayudarte a elegir bien.</p>
      </div>
      <div class="finder-controls">
        <div class="finder-input-wrap">
          <span class="finder-sparkle" aria-hidden="true">✦</span>
          <input
            type="text"
            id="finderInput"
            class="finder-input"
            placeholder="Cuéntanos qué buscas..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="finder-chips">
          {finderSuggestions.map(s => (
            <button class="finder-chip" data-q={s.q} type="button">{s.label}</button>
          ))}
        </div>
      </div>
    </div>
    <div class="finder-results" id="finderResults" hidden></div>
  </section>

  <hr class="section-divider" />

  {/* ── Editorial section ("Artículos Destacados") ── */}
  {editorialFeatured && (
    <section class="editorial-section">
      <div class="editorial-header">
        <h2 class="editorial-title">Artículos Destacados</h2>
        <p class="editorial-sub">Selección editorial de PielSmart</p>
      </div>
      <div class="editorial-grid">

        {/* Featured left: image LEFT + text RIGHT */}
        <a href={`/${editorialFeatured.data.pillar}/${editorialFeatured.id}/`} class="ed-featured">
          {editorialFeatured.data.image && (
            <div class="ed-featured-img">
              <img
                src={`${editorialFeatured.data.image}?auto=compress&cs=tinysrgb&w=600&h=360&fit=crop`}
                alt={editorialFeatured.data.title}
                loading="lazy"
              />
            </div>
          )}
          <div class="ed-featured-body">
            <span class="ed-label">{pillarNames[editorialFeatured.data.pillar]}</span>
            <h3 class="ed-featured-title">{editorialFeatured.data.title}</h3>
            <p class="ed-featured-desc">{editorialFeatured.data.description}</p>
            <span class="ed-date">Actualizado {formatDate(editorialFeatured.data.datePublished)}</span>
          </div>
        </a>

        {/* Right list: text LEFT + thumb RIGHT */}
        <div class="ed-list">
          {editorialList.map((article, idx) => (
            <>
              <a href={`/${article.data.pillar}/${article.id}/`} class="ed-list-item">
                <div class="ed-list-body">
                  <span class="ed-label">{pillarNames[article.data.pillar]}</span>
                  <p class="ed-list-title">{article.data.title}</p>
                  <span class="ed-date">Actualizado {formatDate(article.data.datePublished)}</span>
                </div>
                {article.data.image && (
                  <div class="ed-list-thumb">
                    <img
                      src={`${article.data.image}?auto=compress&cs=tinysrgb&w=160&h=120&fit=crop`}
                      alt={article.data.title}
                      loading="lazy"
                    />
                  </div>
                )}
              </a>
              {idx < editorialList.length - 1 && <hr class="ed-divider" />}
            </>
          ))}
        </div>

      </div>
    </section>
  )}

  <hr class="section-divider" />

  {/* ── Per-pillar category sections ── */}
  {pillarOrder.map(pillar => {
    const articles = (byPillar.get(pillar) ?? []).slice(0, 3);
    if (articles.length === 0) return null;
    const subcats = pillarSubcats[pillar] ?? [];
    return (
      <section class="pillar-section">
        <div class="pillar-header">
          <div class="pillar-header-top">
            <h2 class="pillar-title">{pillarNames[pillar]}</h2>
            <a href={`/${pillar}/`} class="pillar-more">ver todo en {pillarNames[pillar]} →</a>
          </div>
          {subcats.length > 0 && (
            <div class="pillar-subcats">
              {subcats.map((sc, i) => (
                <>
                  <a href={sc.href} class="pillar-subcat">{sc.label}</a>
                  {i < subcats.length - 1 && <span class="subcat-dot">·</span>}
                </>
              ))}
            </div>
          )}
        </div>

        <div class={`pillar-cards ${articles.length === 1 ? 'pillar-cards--one' : articles.length === 2 ? 'pillar-cards--two' : ''}`}>
          {articles.map(article => (
            <a href={`/${article.data.pillar}/${article.id}/`} class="pillar-card">
              {article.data.image && (
                <div class="pillar-card-img">
                  <img
                    src={`${article.data.image}?auto=compress&cs=tinysrgb&w=500&h=280&fit=crop`}
                    alt={article.data.title}
                    loading="lazy"
                  />
                </div>
              )}
              <div class="pillar-card-body">
                <p class="pillar-card-title">{article.data.title}</p>
                <span class="pillar-card-date">Actualizado {formatDate(article.data.datePublished)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  {/* ── Browse nav ── */}
  <nav class="browse-nav" aria-label="Explorar categorías">
    <span class="browse-label">Explorar:</span>
    {pillars.map(({ slug, nombre }, i) => (
      <>
        <a href={`/${slug}/`} class="browse-link">{nombre}</a>
        {i < pillars.length - 1 && <span class="browse-dot">·</span>}
      </>
    ))}
  </nav>

</BaseLayout>

<style>
/* ══════════════════════════════════════════
   HERO — 3-column
══════════════════════════════════════════ */
.hero-grid {
  display: grid;
  grid-template-columns: 200px 1fr 200px;
  gap: 0;
  margin: 2rem 0 0;
  align-items: start;
}

/* Shared sidebar styles */
.hero-sidebar-left,
.hero-sidebar-right {
  padding-top: 0.25rem;
}
.hero-sidebar-left { padding-right: 1.5rem; border-right: 1px solid #e8e8e8; }
.hero-sidebar-right { padding-left: 1.5rem; border-left: 1px solid #e8e8e8; overflow: hidden; }

.sidebar-title {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #999;
  font-family: 'DM Sans', sans-serif;
  margin: 0 0 0.875rem;
  border-bottom: 1px solid #e8e8e8;
  padding-bottom: 0.5rem;
}

/* Left sidebar — article list */
.sidebar-list {
  list-style: none;
  margin: 0 0 0.75rem;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.sidebar-list li { border-bottom: 1px solid #f0f0f0; }
.sidebar-link {
  display: block;
  padding: 0.6rem 0;
  font-size: 0.82rem;
  color: #222;
  text-decoration: none;
  line-height: 1.35;
  font-family: 'DM Sans', sans-serif;
  transition: color 0.15s;
}
.sidebar-link:hover { color: #c4693a; }
.sidebar-pillar {
  display: block;
  font-size: 0.62rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: #c4693a;
  margin-bottom: 0.15rem;
}
.sidebar-see-all {
  font-size: 0.78rem;
  color: #c4693a;
  text-decoration: none;
  font-family: 'DM Sans', sans-serif;
  font-weight: 600;
}
.sidebar-see-all:hover { text-decoration: underline; }

/* Center featured */
.hero-center {
  display: flex;
  flex-direction: column;
  padding: 0 2rem;
  gap: 0;
}
.hero-center-story {
  display: block;
  text-decoration: none;
  color: inherit;
}
.hero-center-divider {
  border: none;
  border-top: 1px solid #e8e8e8;
  margin: 1rem 0;
}
.hero-center-img {
  width: 100%;
  height: 210px;
  overflow: hidden;
  margin-bottom: 0.9rem;
}
.hero-center-img--sm {
  height: 150px;
}
.hero-center-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s;
}
.hero-center-story:hover .hero-center-img img { transform: scale(1.02); }

.hero-center-byline {
  font-size: 0.72rem;
  color: #999;
  font-family: 'DM Sans', sans-serif;
  display: block;
  margin-bottom: 0.4rem;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.hero-center-title {
  font-size: clamp(1.2rem, 2.2vw, 1.7rem);
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 700;
  color: #111;
  margin: 0 0 0.6rem;
  line-height: 1.18;
}
.hero-center-title--sm {
  font-size: clamp(1rem, 1.6vw, 1.25rem);
  margin-bottom: 0;
}
.hero-center-story:hover .hero-center-title { color: #c4693a; }
.hero-center-desc {
  font-size: 0.9rem;
  color: #555;
  line-height: 1.65;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Right sidebar — deals */
.deals-list {
  list-style: none;
  margin: 0 0 0.75rem;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.deal-item {
  padding: 0.65rem 0;
  border-bottom: 1px solid #f0f0f0;
}
.deal-img-link { display: block; margin-bottom: 0.4rem; }
.deal-img-link img {
  width: 100%;
  height: 110px;
  object-fit: contain;
  background: #f9f9f9;
  border-radius: 4px;
  display: block;
}
.deal-name {
  font-size: 0.78rem;
  color: #111;
  text-decoration: none;
  line-height: 1.35;
  font-family: 'DM Sans', sans-serif;
  display: block;
  margin-bottom: 0.3rem;
}
.deal-name:hover { color: #c4693a; text-decoration: underline; }
.deal-rating-row {
  display: flex; align-items: center; gap: 0.25rem; margin-bottom: 0.25rem;
}
.deal-stars { color: #FF9900; font-size: 0.72rem; letter-spacing: -0.5px; }
.deal-rating-num { font-size: 0.72rem; font-weight: 700; color: #111; font-family: 'DM Sans', sans-serif; }
.deal-reviews { font-size: 0.7rem; color: #888; font-family: 'DM Sans', sans-serif; }
.deal-price-row { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
.deal-list-price {
  font-size: 0.78rem; color: #888; font-family: 'DM Sans', sans-serif;
  text-decoration: line-through;
}
.deal-price { font-size: 0.88rem; font-weight: 700; color: #b12704; font-family: 'DM Sans', sans-serif; }
.deal-badge {
  font-size: 0.68rem;
  font-weight: 700;
  background: #b12704;
  color: #fff;
  padding: 0.15rem 0.4rem;
  border-radius: 4px;
}

/* Dividers */
.hero-divider {
  border: none;
  border-top: 2px solid #111;
  margin: 2rem 0;
}
.section-divider {
  border: none;
  border-top: 1px solid #e0e0e0;
  margin: 0 0 2.5rem;
}

/* ══════════════════════════════════════════
   FINDER
══════════════════════════════════════════ */
.finder-section {
  background: #f7f5f2;
  border-radius: 10px;
  padding: 1.75rem 2rem;
  margin-bottom: 2.5rem;
}
.finder-body {
  display: grid;
  grid-template-columns: 1fr 1.8fr;
  gap: 2rem;
  align-items: start;
}
.finder-headline {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: #111;
  margin: 0 0 0.4rem;
  line-height: 1.2;
}
.finder-sub {
  font-size: 0.85rem;
  color: #666;
  margin: 0;
  font-family: 'DM Sans', sans-serif;
}
.finder-controls { display: flex; flex-direction: column; gap: 0.75rem; }
.finder-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1.5px solid #ddd;
  border-radius: 100px;
  padding: 0 1.1rem;
  gap: 0.6rem;
  height: 44px;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.finder-input-wrap:focus-within {
  border-color: #c4693a;
  box-shadow: 0 0 0 3px rgba(196,105,58,0.12);
}
.finder-sparkle { font-size: 0.9rem; color: #c4693a; flex-shrink: 0; }
.finder-input {
  flex: 1; border: none; background: transparent;
  font-size: 0.88rem; color: #333;
  font-family: 'DM Sans', sans-serif; outline: none;
}
.finder-input::placeholder { color: #bbb; }
.finder-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
.finder-chip {
  font-size: 0.75rem; font-family: 'DM Sans', sans-serif;
  color: #444; background: #fff; border: 1px solid #ddd;
  border-radius: 100px; padding: 0.3rem 0.75rem;
  cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
  line-height: 1.4;
}
.finder-chip:hover { background: #fdf0ea; border-color: #c4693a; color: #c4693a; }
.finder-results { margin-top: 1.1rem; border-top: 1px solid #e8e0d8; padding-top: 1.1rem; }
.finder-results[hidden] { display: none; }
.fr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.875rem; }
.fr-item {
  display: flex; gap: 0.7rem; text-decoration: none; color: inherit;
  padding: 0.65rem; border-radius: 7px; transition: background 0.15s;
}
.fr-item:hover { background: #fff; }
.fr-thumb { width: 60px; height: 46px; border-radius: 3px; overflow: hidden; flex-shrink: 0; }
.fr-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.fr-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
.fr-label {
  font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.8px; color: #c4693a; font-family: 'DM Sans', sans-serif;
}
.fr-title {
  font-size: 0.8rem; font-weight: 600; color: #111;
  font-family: 'Playfair Display', Georgia, serif; line-height: 1.3;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.fr-item:hover .fr-title { color: #c4693a; }
.fr-empty { font-size: 0.85rem; color: #999; font-family: 'DM Sans', sans-serif; text-align: center; padding: 0.5rem 0; }

/* ══════════════════════════════════════════
   EDITORIAL SECTION
══════════════════════════════════════════ */
.editorial-section { margin-bottom: 2.5rem; }

.editorial-header { margin-bottom: 1.25rem; }
.editorial-title {
  font-family: 'DM Sans', sans-serif;
  font-size: 1.15rem; font-weight: 700; color: #111;
  margin: 0 0 0.2rem; text-transform: uppercase; letter-spacing: 0.5px;
}
.editorial-sub {
  font-size: 0.82rem; color: #888; font-family: 'DM Sans', sans-serif;
  margin: 0; font-style: italic;
}

.editorial-grid {
