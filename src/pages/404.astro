---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  { label: 'Skincare', href: '/skincare/', emoji: '✨' },
  { label: 'Maquillaje', href: '/maquillaje/', emoji: '💄' },
  { label: 'Cabello', href: '/cabello/', emoji: '💇' },
  { label: 'Uñas', href: '/unas/', emoji: '💅' },
  { label: 'Perfumes', href: '/perfumes/', emoji: '🌸' },
  { label: 'Dispositivos', href: '/dispositivos/', emoji: '⚡' },
];
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe. Explora nuestras guías de belleza en skincare, maquillaje, cabello, uñas y perfumes."
>
  <div class="not-found">
    <p class="nf-code">404</p>
    <h1 class="nf-title">Esta página no existe</h1>
    <p class="nf-desc">El enlace puede estar roto o la página fue movida. Prueba desde el inicio o explora una categoría:</p>

    <div class="nf-categories">
      {categories.map(c => (
        <a href={c.href} class="nf-cat">
          <span class="nf-cat-emoji">{c.emoji}</span>
          <span>{c.label}</span>
        </a>
      ))}
    </div>

    <a href="/" class="nf-home">← Volver al inicio</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 1rem 6rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .nf-code {
    font-size: 6rem;
    font-weight: 700;
    font-family: 'Playfair Display', Georgia, serif;
    color: #e8e2d9;
    line-height: 1;
    margin: 0 0 0.5rem;
  }

  .nf-title {
    font-size: 1.75rem;
    color: #1a1a2e;
    margin: 0 0 1rem;
  }

  .nf-desc {
    color: #6b7280;
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 2.5rem;
  }

  .nf-categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .nf-cat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem 0.75rem;
    border: 1.5px solid #e8e2d9;
    border-radius: 12px;
    text-decoration: none;
    color: #1a1a2e;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .nf-cat:hover {
    border-color: #c4693a;
    box-shadow: 0 2px 10px rgba(196,105,58,0.1);
    color: #c4693a;
  }

  .nf-cat-emoji { font-size: 1.5rem; }

  .nf-home {
    display: inline-block;
    color: #c4693a;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .nf-home:hover { text-decoration: underline; }

  @media (max-width: 480px) {
    .nf-categories { grid-template-columns: repeat(2, 1fr); }
    .nf-code { font-size: 4rem; }
  }
</style>
