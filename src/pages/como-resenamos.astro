    font-size: 1.1rem;
    color: #4b5563;
    line-height: 1.8;
    margin-bottom: 2rem;
    border-left: 4px solid #e07b39;
    padding-left: 1rem;
  }
  h2 {
    margin-top: 2rem;
    font-size: 1.3rem;
  }
  ul {
    padding-left: 1.4rem;
  }
  ul li {
    margin-bottom: 0.6rem;
    line-height: 1.7;
  }
</style>
