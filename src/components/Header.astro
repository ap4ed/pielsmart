---
const nav = [
  { label: 'Skincare', href: '/skincare/' },
  { label: 'Maquillaje', href: '/maquillaje/' },
  { label: 'Cabello', href: '/cabello/' },
  { label: 'Uñas', href: '/unas/' },
  { label: 'Perfumes', href: '/perfumes/' },
  { label: 'Dispositivos', href: '/dispositivos/' },
  { label: 'Cómo Reseñamos', href: '/como-resenamos/' },
];

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="header-top">
    <a href="/" class="logo">
      <span class="logo-piel">Piel</span><span class="logo-smart">Smart</span>
    </a>

    {/* ── Finder input ── */}
    <div class="header-finder" id="headerFinderWrap">
      <form class="header-finder-form" action="/" method="get" autocomplete="off" id="headerFinderForm">
        <span class="finder-icon" aria-hidden="true">✦</span>
        <span class="finder-label">PielSmart Finder</span>
        <input
          type="text"
          name="q"
          id="headerFinderInput"
          class="header-finder-input"
          placeholder="¿Qué tipo de sérum necesito? ¿Perfume para regalar?"
          aria-label="Buscar en PielSmart"
          aria-autocomplete="list"
          aria-controls="headerFinderResults"
          aria-expanded="false"
          role="combobox"
          spellcheck="false"
        />
      </form>
      {/* Dropdown results */}
      <div
        class="header-finder-results"
        id="headerFinderResults"
        role="listbox"
        aria-label="Resultados de búsqueda"
        hidden
      ></div>
    </div>
    <button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="header-nav-row" id="mainNavRow">
    <nav aria-label="Navegación principal">
      <ul>
        {nav.map(({ label, href }) => (
          <li>
            <a href={href} class={pathname.startsWith(href) ? 'active' : ''}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid #e8e8e8;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  }

  /* ── Top row: logo + finder ── */
  .header-top {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 60px;
  }

  .logo {
    text-decoration: none;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    flex-shrink: 0;
    line-height: 1;
  }
  .logo-piel { color: #1a1a2e; }
  .logo-smart { color: #c4693a; }

  /* ── Finder ── */
  .header-finder {
    flex: 1;
    position: relative;
    max-width: 640px;
  }

  .header-finder-form {
    display: flex;
    align-items: center;
    background: #f7f5f3;
    border: 1.5px solid #e0dbd6;
    border-radius: 100px;
    padding: 0 1.1rem;
    gap: 0.6rem;
    height: 40px;
    transition: border-color 0.15s, box-shadow 0.15s;
    cursor: text;
  }
  .header-finder-form:focus-within {
    border-color: #c4693a;
    box-shadow: 0 0 0 3px rgba(196,105,58,0.12);
    background: #fff;
  }

  .finder-icon {
    font-size: 0.9rem;
    color: #c4693a;
    flex-shrink: 0;
    line-height: 1;
  }

  .finder-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1a1a2e;
    font-family: 'DM Sans', sans-serif;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .header-finder-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.85rem;
    color: #333;
    font-family: 'DM Sans', sans-serif;
    outline: none;
    min-width: 0;
  }
  .header-finder-input::placeholder { color: #aaa; }

  /* ── Dropdown results ── */
  .header-finder-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #e2ddd9;
    border-radius: 14px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.04), 0 16px 40px rgba(0,0,0,0.11);
    overflow: hidden;
    z-index: 9999;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .header-finder-results.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .header-finder-results[hidden] { display: none; }

  .hfr-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.1s;
    border-bottom: 1px solid #f3f0ed;
    outline: none;
    cursor: pointer;
  }
  .hfr-item:last-of-type { border-bottom: none; }
  .hfr-item:hover,
  .hfr-item[aria-selected="true"] { background: #fdf5f1; }
  .hfr-item[aria-selected="true"] .hfr-title { color: #c4693a; }

  .hfr-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hfr-body {
    flex: 1;
    min-width: 0;
  }

  .hfr-label {
    font-size: 0.63rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #999;
    font-family: 'DM Sans', sans-serif;
    display: block;
    margin-bottom: 0.15rem;
  }

  .hfr-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a2e;
    font-family: 'DM Sans', sans-serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.1s;
    line-height: 1.3;
  }

  .hfr-arrow {
    font-size: 0.8rem;
    color: #ddd;
    flex-shrink: 0;
    transition: color 0.12s, transform 0.12s;
  }
  .hfr-item:hover .hfr-arrow,
  .hfr-item[aria-selected="true"] .hfr-arrow {
    color: #c4693a;
    transform: translateX(3px);
  }

  .hfr-empty {
    padding: 1.2rem 1rem;
    text-align: center;
    font-size: 0.84rem;
    color: #bbb;
    font-family: 'DM Sans', sans-serif;
  }

  .hfr-footer {
    display: block;
    padding: 0.55rem 1rem;
    background: #faf9f7;
    border-top: 1px solid #f0ece8;
    font-size: 0.75rem;
    font-family: 'DM Sans', sans-serif;
    color: #aaa;
    text-align: center;
    text-decoration: none;
    transition: color 0.1s, background 0.1s;
  }
  .hfr-footer:hover { color: #c4693a; background: #fdf5f1; }

  /* ── Nav row ── */
  .header-nav-row {
    border-top: 1px solid #f0ece8;
  }

  .header-nav-row nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .header-nav-row nav::-webkit-scrollbar { display: none; }

  .header-nav-row ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  .header-nav-row a {
    color: #4b4b4b;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.55rem 0.8rem;
    display: block;
    font-family: 'DM Sans', sans-serif;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .header-nav-row a:hover {
    color: #c4693a;
    border-bottom-color: #c4693a;
  }
  .header-nav-row a.active {
    color: #c4693a;
    font-weight: 600;
    border-bottom-color: #c4693a;
  }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 4px;
    flex-shrink: 0;
    flex-direction: column;
    gap: 5px;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #1a1a2e;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hamburger { display: flex; }
    .finder-label { display: none; }
    .header-finder-input::placeholder { font-size: 0.8rem; }
    #mainNavRow { display: none; }
    #mainNavRow.open { display: block; }
    #mainNavRow.open ul { flex-wrap: wrap; }
    #mainNavRow.open li { width: 50%; }
    #mainNavRow.open a { font-size: 0.88rem; padding: 0.6rem 1rem; }
  }
  @media (max-width: 420px) {
    .header-top { gap: 0.75rem; }
    .logo { font-size: 1.25rem; }
  }
</style>

<script>
  // ── Header Finder client-side search ──
  (function () {
    const input = document.getElementById('headerFinderInput');
    const results = document.getElementById('headerFinderResults');
    const form = document.getElementById('headerFinderForm');
    if (!input || !results) return;

    const PILLAR_NAMES = {
      skincare: 'Skincare', maquillaje: 'Maquillaje', cabello: 'Cabello',
      unas: 'Uñas', perfumes: 'Perfumes', dispositivos: 'Dispositivos'
    };

    let activeIndex = -1;

    function getArticles() { return (window).__PS_ARTICLES__ || []; }

    function normalize(s) {
      return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    const STOP = new Set('el la los las un una unos unas de del en con para por sin a al me mi mis yo tu te su necesito quiero busco tengo hay es son ser usar utilizar cual cuales como que donde muy mas tanto poco mucho algo mejor mejores bueno buena buenos buenas buen hacer quitar poner aplicar conseguir comprar recomiendas recomienda recomiendo recomiendan probaste probar quito quitas tienes tienen pongo pones ponerse debo deberia tipo tipos clase clases sirve sirven sirva dime cual cuales necesitas necesita quieres quiere viene vienen'.split(' '));

    function search(q) {
      if (!q || q.trim().length < 2) return [];
      const terms = normalize(q.trim()).split(/\s+/).filter(t => t.length > 1 && !STOP.has(t));
      if (terms.length === 0) return [];
      const scored = getArticles().map(a => {
        const hay = normalize(a.title + ' ' + a.description + ' ' + a.pillar + ' ' + (a.keyword || '') + ' ' + (a.tags || ''));
        const matches = terms.filter(t => hay.includes(t)).length;
        return { a, matches };
      }).filter(({ matches }) => matches > 0);
      scored.sort((x, y) => y.matches - x.matches);
      return scored.map(({ a }) => a).slice(0, 5);
    }

    function show() {
      results.hidden = false;
      // trigger animation on next frame
      requestAnimationFrame(() => results.classList.add('is-visible'));
      input.setAttribute('aria-expanded', 'true');
    }

    function hide() {
      results.classList.remove('is-visible');
      results.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    }

    function setActive(index) {
      const items = results.querySelectorAll('.hfr-item');
      items.forEach((el, i) => {
        el.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
      if (index >= 0 && items[index]) {
        input.setAttribute('aria-activedescendant', items[index].id);
        items[index].scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
      activeIndex = index;
    }

    const PILLAR_COLORS = {
      skincare: '#7DB9A8', maquillaje: '#C4728A', cabello: '#C9A35E',
      unas: '#9B7EC8', perfumes: '#C47898', dispositivos: '#5E9EC4'
    };

    function render(items) {
      activeIndex = -1;
      if (items.length === 0) {
        results.innerHTML = '<div class="hfr-empty">Sin resultados — intenta con otras palabras</div>';
      } else {
        const cards = items.map((a, i) => {
          const color = PILLAR_COLORS[a.pillar] || '#c4693a';
          return `
            <a href="/${a.pillar}/${a.id}/" class="hfr-item" role="option" id="hfr-opt-${i}" aria-selected="false">
              <span class="hfr-dot" style="background:${color}" aria-hidden="true"></span>
              <div class="hfr-body">
                <span class="hfr-label">${PILLAR_NAMES[a.pillar] || a.pillar}</span>
                <div class="hfr-title">${a.title}</div>
              </div>
              <span class="hfr-arrow" aria-hidden="true">→</span>
            </a>
          `;
        }).join('');
        const footer = `<a href="/" class="hfr-footer" tabindex="-1">Explorar todos los artículos →</a>`;
        results.innerHTML = cards + footer;
      }
      show();
    }

    let debounce;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = input.value.trim();
      if (q.length < 2) { hide(); return; }
      debounce = setTimeout(() => render(search(q)), 160);
    });

    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (results.hidden) return;
      const items = results.querySelectorAll('.hfr-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(Math.min(activeIndex + 1, items.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(Math.max(activeIndex - 1, 0));
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && items[activeIndex]) {
          e.preventDefault();
          items[activeIndex].click();
        }
      } else if (e.key === 'Escape') {
        hide();
        input.blur();
      }
    });

    form.addEventListener('submit', (e) => {
      const q = input.value.trim();
      if (q.length >= 2 && search(q).length > 0) {
        e.preventDefault();
        const first = results.querySelector('.hfr-item');
        if (first) first.click();
      }
    });

    document.addEventListener('click', (e) => {
      if (!document.getElementById('headerFinderWrap')?.contains(e.target)) hide();
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length >= 2) {
        const hits = search(input.value.trim());
        if (hits.length) render(hits);
      }
    });
  })();

  // ── Mobile hamburger ──
  (function() {
    const btn = document.getElementById('hamburgerBtn');
    const nav = document.getElementById('mainNavRow');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      btn.classList.toggle('open', isOpen);
      btn.setAttribute('aria-expanded', String(isOpen));
    });
    // Close when a nav link is clicked
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        nav.classList.remove('open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
