---
const nav = [
  { label: 'Skincare', href: '/skincare/' },
  { label: 'Maquillaje', href: '/maquillaje/' },
  { label: 'Cabello', href: '/cabello/' },
  { label: 'Uñas', href: '/unas/' },
  { label: 'Perfumes', href: '/perfumes/' },
  { label: 'Dispositivos', href: '/dispositivos/' },
  { label: 'Cómo Reseñamos', href: '/como-resenamos/' },
];

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-piel">Piel</span><span class="logo-smart">Smart</span>
    </a>
    <nav aria-label="Navegación principal">
      <ul>
        {nav.map(({ label, href }) => (
          <li>
            <a href={href} class={pathname.startsWith(href) ? 'active' : ''}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid #f0e8e4;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 8px rgba(0,0,0,0.06);
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }
  .logo {
    text-decoration: none;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    flex-shrink: 0;
    line-height: 1;
  }
  .logo-piel { color: #1a1a2e; }
  .logo-smart { color: #c4693a; }

  nav {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  nav a {
    color: #4b4b4b;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
    display: block;
  }
  nav a:hover {
    background: #fdf0ea;
    color: #c4693a;
  }
  nav a.active {
    color: #c4693a;
    font-weight: 600;
  }
</style>
