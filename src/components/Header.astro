---
const nav = [
  { label: 'Skincare', href: '/skincare/' },
  { label: 'Maquillaje', href: '/maquillaje/' },
  { label: 'Cabello', href: '/cabello/' },
  { label: 'Uñas', href: '/unas/' },
  { label: 'Perfumes', href: '/perfumes/' },
  { label: 'Dispositivos', href: '/dispositivos/' },
  { label: 'Cómo Reseñamos', href: '/como-resenamos/' },
];

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="header-top">
    <a href="/" class="logo">
      <span class="logo-piel">Piel</span><span class="logo-smart">Smart</span>
    </a>

    {/* ── Finder input ── */}
    <div class="header-finder" id="headerFinderWrap">
      <form class="header-finder-form" action="/" method="get" autocomplete="off" id="headerFinderForm">
        <span class="finder-icon" aria-hidden="true">✦</span>
        <span class="finder-label">PielSmart Finder</span>
        <input
          type="text"
          name="q"
          id="headerFinderInput"
          class="header-finder-input"
          placeholder="¿Qué tipo de sérum necesito? ¿Perfume para regalar?"
          aria-label="Buscar en PielSmart"
          spellcheck="false"
        />
      </form>
      {/* Dropdown results */}
      <div class="header-finder-results" id="headerFinderResults" hidden></div>
    </div>
  </div>

  <div class="header-nav-row">
    <nav aria-label="Navegación principal">
      <ul>
        {nav.map(({ label, href }) => (
          <li>
            <a href={href} class={pathname.startsWith(href) ? 'active' : ''}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid #e8e8e8;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  }

  /* ── Top row: logo + finder ── */
  .header-top {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 60px;
  }

  .logo {
    text-decoration: none;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    flex-shrink: 0;
    line-height: 1;
  }
  .logo-piel { color: #1a1a2e; }
  .logo-smart { color: #c4693a; }

  /* ── Finder ── */
  .header-finder {
    flex: 1;
    position: relative;
    max-width: 640px;
  }

  .header-finder-form {
    display: flex;
    align-items: center;
    background: #f7f5f3;
    border: 1.5px solid #e0dbd6;
    border-radius: 100px;
    padding: 0 1.1rem;
    gap: 0.6rem;
    height: 40px;
    transition: border-color 0.15s, box-shadow 0.15s;
    cursor: text;
  }
  .header-finder-form:focus-within {
    border-color: #c4693a;
    box-shadow: 0 0 0 3px rgba(196,105,58,0.12);
    background: #fff;
  }

  .finder-icon {
    font-size: 0.9rem;
    color: #c4693a;
    flex-shrink: 0;
    line-height: 1;
  }

  .finder-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1a1a2e;
    font-family: 'DM Sans', sans-serif;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .header-finder-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.85rem;
    color: #333;
    font-family: 'DM Sans', sans-serif;
    outline: none;
    min-width: 0;
  }
  .header-finder-input::placeholder { color: #aaa; }

  /* ── Dropdown results ── */
  .header-finder-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.13);
    overflow: hidden;
    z-index: 200;
  }
  .header-finder-results[hidden] { display: none; }

  .hfr-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.1s;
    border-bottom: 1px solid #f5f5f5;
  }
  .hfr-item:last-child { border-bottom: none; }
  .hfr-item:hover { background: #fdf0ea; }

  .hfr-thumb {
    width: 48px;
    height: 36px;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .hfr-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hfr-body {
    flex: 1;
    min-width: 0;
  }

  .hfr-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #c4693a;
    font-family: 'DM Sans', sans-serif;
    display: block;
    margin-bottom: 0.15rem;
  }

  .hfr-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #1a1a2e;
    font-family: 'Playfair Display', Georgia, serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hfr-empty {
    padding: 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: #999;
    font-family: 'DM Sans', sans-serif;
  }

  /* ── Nav row ── */
  .header-nav-row {
    border-top: 1px solid #f0ece8;
  }

  .header-nav-row nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .header-nav-row nav::-webkit-scrollbar { display: none; }

  .header-nav-row ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  .header-nav-row a {
    color: #4b4b4b;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.55rem 0.8rem;
    display: block;
    font-family: 'DM Sans', sans-serif;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .header-nav-row a:hover {
    color: #c4693a;
    border-bottom-color: #c4693a;
  }
  .header-nav-row a.active {
    color: #c4693a;
    font-weight: 600;
    border-bottom-color: #c4693a;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .finder-label { display: none; }
    .header-finder-input::placeholder { font-size: 0.8rem; }
  }
  @media (max-width: 420px) {
    .header-top { gap: 0.75rem; }
    .logo { font-size: 1.25rem; }
  }
</style>

<script>
  // ── Header Finder client-side search ──
  // Article data is injected by the page via window.__PS_ARTICLES__
  (function () {
    const input = document.getElementById('headerFinderInput');
    const results = document.getElementById('headerFinderResults');
    const form = document.getElementById('headerFinderForm');
    if (!input || !results) return;

    const PILLAR_NAMES = {
      skincare: 'Skincare', maquillaje: 'Maquillaje', cabello: 'Cabello',
      unas: 'Uñas', perfumes: 'Perfumes', dispositivos: 'Dispositivos'
    };

    function getArticles() {
      return (window).__PS_ARTICLES__ || [];
    }

    function search(q) {
      if (!q || q.trim().length < 2) return [];
      const terms = q.toLowerCase().trim().split(/\s+/);
      return getArticles().filter(a => {
        const hay = (a.title + ' ' + a.description + ' ' + a.pillar + ' ' + (a.keyword || '')).toLowerCase();
        return terms.every(t => hay.includes(t));
      }).slice(0, 5);
    }

    function render(items) {
      if (items.length === 0) {
        results.innerHTML = '<div class="hfr-empty">Sin resultados — intenta con otras palabras</div>';
      } else {
        results.innerHTML = items.map(a => `
          <a href="/${a.pillar}/${a.id}/" class="hfr-item">
            ${a.image ? `<div class="hfr-thumb"><img src="${a.image}?auto=compress&cs=tinysrgb&w=96&h=72&fit=crop" alt="" loading="lazy" /></div>` : ''}
            <div class="hfr-body">
              <span class="hfr-label">${PILLAR_NAMES[a.pillar] || a.pillar}</span>
              <div class="hfr-title">${a.title}</div>
            </div>
          </a>
        `).join('');
      }
      results.hidden = false;
    }

    function hide() { results.hidden = true; }

    let debounce;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = input.value.trim();
      if (q.length < 2) { hide(); return; }
      debounce = setTimeout(() => {
        const hits = search(q);
        render(hits);
      }, 160);
    });

    // Prevent form submission if there's a query — let the dropdown handle it
    form.addEventListener('submit', (e) => {
      const q = input.value.trim();
      if (q.length >= 2 && search(q).length > 0) {
        e.preventDefault();
        // focus first result
        const first = results.querySelector('.hfr-item');
        if (first) first.click();
      }
    });

    document.addEventListener('click', (e) => {
      if (!document.getElementById('headerFinderWrap')?.contains(e.target)) hide();
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length >= 2) {
        const hits = search(input.value.trim());
        if (hits.length) render(hits);
      }
    });
  })();
</script>
