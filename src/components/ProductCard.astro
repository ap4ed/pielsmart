---
interface Props {
  asin?: string;
  name: string;
  description: string;
  rating?: number;
  reviews?: string;
  link: string;
}

const { asin, name, description, rating = 4.5, reviews, link } = Astro.props;

const imageUrl = asin
  ? `https://ws-na.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=${asin}&Format=_SL250_&ID=AsinImage&MarketPlace=US&ServiceVersion=20070822&WS=1&tag=pielsmart-20`
  : null;

const fullStars = Math.floor(rating);
const hasHalf = rating % 1 >= 0.5;
const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
---

<div class="product-card">
  {imageUrl && (
    <div class="product-img-wrap">
      <a href={link} target="_blank" rel="noopener nofollow">
        <img
          src={imageUrl}
          alt={name}
          class="product-img"
          loading="lazy"
          onerror="this.closest('.product-img-wrap').style.display='none'"
        />
      </a>
    </div>
  )}
  <div class="product-body">
    <p class="product-name">
      <a href={link} target="_blank" rel="noopener nofollow">{name}</a>
    </p>
    <div class="product-rating">
      <span class="stars">
        {'★'.repeat(fullStars)}{hasHalf ? '½' : ''}{'☆'.repeat(emptyStars)}
      </span>
      <span class="rating-num">{rating.toFixed(1)}</span>
      {reviews && <span class="review-count">({reviews} reseñas)</span>}
    </div>
    <p class="product-desc">{description}</p>
    <a href={link} target="_blank" rel="noopener nofollow" class="amazon-btn">
      Ver en Amazon →
    </a>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    gap: 1.25rem;
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1rem;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .product-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    border-color: #d0d0d0;
  }
  .product-img-wrap {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-img {
    width: 120px;
    height: 120px;
    object-fit: contain;
    border-radius: 8px;
  }
  .product-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .product-name {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: #1a1a2e;
  }
  .product-name a {
    color: inherit;
    text-decoration: none;
  }
  .product-name a:hover { text-decoration: underline; }
  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
  }
  .stars { color: #e07b39; font-size: 0.9rem; letter-spacing: 1px; }
  .rating-num { font-weight: 600; color: #2d2d2d; }
  .review-count { color: #888; }
  .product-desc {
    margin: 0;
    font-size: 0.875rem;
    color: #5a5a6e;
    line-height: 1.6;
    flex: 1;
  }
  .amazon-btn {
    display: inline-block;
    margin-top: 0.5rem;
    background: #FF9900;
    color: #111;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    width: fit-content;
    transition: background 0.15s;
  }
  .amazon-btn:hover { background: #e68900; color: #111; }

  @media (max-width: 480px) {
    .product-card { flex-direction: column; }
    .product-img-wrap { width: 100%; height: 160px; }
    .product-img { width: 100%; height: 160px; }
  }
</style>
