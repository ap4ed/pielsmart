---
interface Props {
  asin?: string;
  name: string;
  tagline: string;
  why: string;
  price: string;
  listPrice?: string;
  discount?: string;
  coupon?: string;
  rating?: string;
  reviews?: string;
  badge?: string;
  badgeColor?: string;
  link: string;
  image?: string;
  retailer?: string;
}

const {
  asin,
  name,
  tagline,
  why,
  price,
  listPrice,
  discount,
  coupon,
  rating,
  reviews,
  badge,
  badgeColor = '#c4693a',
  link,
  image,
  retailer = 'Amazon',
} = Astro.props;

const imageUrl = image ?? (asin
  ? `https://ws-na.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=${asin}&Format=_SL250_&ID=AsinImage&MarketPlace=US&ServiceVersion=20070822&WS=1&tag=pielsmart-20`
  : null);
---

<div class="wc-card">
  {badge && (
    <div class="wc-badge" style={`background:${badgeColor}`}>{badge}</div>
  )}
  <div class="wc-inner">
    {imageUrl && (
      <div class="wc-img-wrap">
        <a href={link} target="_blank" rel="noopener nofollow">
          <img
            src={imageUrl}
            alt={name}
            class="wc-img"
            loading="lazy"
            onerror="this.closest('.wc-img-wrap').style.display='none'"
          />
        </a>
      </div>
    )}
    <div class="wc-body">
      <h3 class="wc-name">
        <a href={link} target="_blank" rel="noopener nofollow">{name}</a>
      </h3>
      <p class="wc-tagline">{tagline}</p>
      {(rating || reviews) && (
        <div class="wc-rating">
          {rating && <span class="wc-stars">{'★'.repeat(Math.round(parseFloat(rating)))}{'☆'.repeat(5 - Math.round(parseFloat(rating)))}</span>}
          {rating && <span class="wc-rating-num">{rating}</span>}
          {reviews && <span class="wc-reviews">({reviews})</span>}
        </div>
      )}
      <div class="wc-buy-row">
        <div class="wc-price-block">
          <span class="wc-price">{price}</span>
          {listPrice && listPrice !== price && (
            <span class="wc-list-price">{listPrice}</span>
          )}
          {discount && <span class="wc-discount">{discount}</span>}
        </div>
        <a href={link} target="_blank" rel="noopener nofollow" class="wc-btn">
          Ver en {retailer} →
        </a>
      </div>
      {coupon && (
        <div class="wc-coupon">🏷️ Cupón disponible: ahorra {coupon} al aplicar en el checkout</div>
      )}
      <div class="wc-why">
        <span class="wc-why-label">Por qué lo elegimos:</span> {why}
      </div>
    </div>
  </div>
</div>

<style>
  .wc-card {
    border: 1px solid #e8e8e8;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.75rem;
    transition: box-shadow 0.2s;
  }
  .wc-card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.09);
  }
  .wc-badge {
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.35rem 1rem;
    font-family: 'DM Sans', sans-serif;
  }
  .wc-inner {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    align-items: flex-start;
  }
  .wc-img-wrap {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f9f9f9;
    border-radius: 10px;
    overflow: hidden;
  }
  .wc-img {
    width: 140px;
    height: 140px;
    object-fit: contain;
  }
  .wc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .wc-name {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.3;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .wc-name a {
    color: #1a1a2e;
    text-decoration: none;
  }
  .wc-name a:hover { text-decoration: underline; }
  .wc-tagline {
    margin: 0;
    font-size: 0.9rem;
    color: #666;
    font-style: italic;
  }
  .wc-rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
  }
  .wc-stars {
    color: #FF9900;
    letter-spacing: -1px;
  }
  .wc-rating-num {
    font-weight: 600;
    color: #1a1a2e;
  }
  .wc-reviews {
    color: #888;
  }
  .wc-buy-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.25rem 0;
    flex-wrap: wrap;
  }
  .wc-price-block {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .wc-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #B12704;
  }
  .wc-list-price {
    font-size: 0.9rem;
    color: #888;
    text-decoration: line-through;
  }
  .wc-discount {
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: #B12704;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  .wc-coupon {
    font-size: 0.82rem;
    color: #2d6a2d;
    background: #edfaed;
    border: 1px solid #b6dfb6;
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
  }
  .wc-btn {
    background: #1a1a2e;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1.1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .wc-btn:hover { background: #333; color: #fff; }
  .wc-why {
    font-size: 0.9rem;
    color: #4a4a5e;
    line-height: 1.7;
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid #f0f0f0;
  }
  .wc-why-label {
    font-weight: 700;
    color: #1a1a2e;
  }

  @media (max-width: 520px) {
    .wc-inner { flex-direction: column; }
    .wc-img-wrap { width: 100%; height: 200px; }
    .wc-img { width: 100%; height: 200px; }
  }
</style>
