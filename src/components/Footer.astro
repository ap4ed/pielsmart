---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-links">
      <a href="/como-resenamos/">Cómo Reseñamos</a>
      <a href="/divulgacion/">Divulgación de Afiliados</a>
    </div>
    <p class="disclosure">
      Como Asociado de Amazon, ganamos comisiones por compras elegibles.
      Los precios y la disponibilidad pueden cambiar. Consulta Amazon para detalles actualizados.
    </p>
    <p class="copyright">© {year} PielSmart. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #e5e7eb;
    padding: 2rem 0;
    margin-top: 4rem;
    background: #f9fafb;
    font-size: 0.85rem;
    color: #6b7280;
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    text-align: center;
  }
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .footer-links a {
    color: #374151;
    text-decoration: none;
    font-weight: 500;
  }
  .footer-links a:hover {
    color: #e07b39;
  }
  .disclosure {
    max-width: 640px;
    margin: 0 auto 0.75rem;
    line-height: 1.6;
  }
  .copyright {
    margin: 0;
  }
</style>
