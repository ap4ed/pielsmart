---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteName = 'PielSmart';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href)
  : undefined;

const allArticles = await getCollection('articles');
const articlesJson = JSON.stringify(allArticles.map(a => ({
  id: a.id,
  title: a.data.title,
  description: a.data.description,
  pillar: a.data.pillar,
  image: a.data.image ?? null,
  keyword: a.data.targetKeyword ?? '',
  tags: (a.data.tags ?? []).join(' '),
})));
---

<!doctype html>
<html lang="es-419">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang es-419 (Latin American Spanish) -->
    <link rel="alternate" hreflang="es-419" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={fullTitle} />}
    <meta property="og:locale" content="es_419" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@pielsmart" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={fullTitle} />}

    <!-- Extra head slot (schemas, etc.) -->
    <slot name="head" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sitemap reference -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Organization schema (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PielSmart",
      "url": "https://pielsmart.com",
      "logo": "https://pielsmart.com/favicon.svg",
      "description": "Guías y reseñas de belleza en español. Skincare, maquillaje, cabello, uñas y perfumes.",
      "sameAs": [
        "https://www.instagram.com/pielsmart",
        "https://www.tiktok.com/@pielsmart",
        "https://www.pinterest.com/pielsmart"
      ]
    })} />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SL7FT6Y126"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SL7FT6Y126');
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" /></noscript>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script define:vars={{ articlesJson }}>
      window.__PS_ARTICLES__ = JSON.parse(articlesJson);
    </script>
    <button class="back-to-top" id="backToTop" aria-label="Volver arriba" hidden>↑</button>
    <script is:inline>
      (function() {
        var btn = document.getElementById('backToTop');
        if (!btn) return;
        window.addEventListener('scroll', function() { btn.hidden = window.scrollY < 400; }, { passive: true });
        btn.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      })();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #2d2d2d;
    background: #fff;
    line-height: 1.75;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }

  h1, h2, h3, h4 {
    font-family: 'Playfair Display', Georgia, serif;
    line-height: 1.25;
    margin-top: 0;
    color: #1a1a2e;
  }

  a { color: #c4693a; }

  img { max-width: 100%; height: auto; }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .back-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #1a1a2e;
    color: #fff;
    border: none;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0,0,0,0.2);
    z-index: 90;
    transition: background 0.15s, transform 0.15s;
  }
  .back-to-top:hover { background: #c4693a; transform: translateY(-2px); }
  .back-to-top[hidden] { display: none; }
</style>
