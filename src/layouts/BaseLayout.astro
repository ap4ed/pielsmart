---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteName = 'PielSmart';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href)
  : undefined;

const allArticles = await getCollection('articles');
const articlesJson = JSON.stringify(allArticles.map(a => ({
  id: a.id,
  title: a.data.title,
  description: a.data.description,
  pillar: a.data.pillar,
  image: a.data.image ?? null,
  keyword: a.data.targetKeyword ?? '',
  tags: (a.data.tags ?? []).join(' '),
})));
---

<!doctype html>
<html lang="es-419">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="p:domain_verify" content="92ae44cd9d16f08fb03be9e5aa349a4e" />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang es-419 (Latin American Spanish) -->
    <link rel="alternate" hreflang="es-419" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={fullTitle} />}
    <meta property="og:locale" content="es_419" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <!-- <meta name="twitter:site" content="@pielsmart" /> -->
    <!-- Add real X/Twitter handle here once account exists -->
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={fullTitle} />}

    <!-- Extra head slot (schemas, etc.) -->
    <slot name="head" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Sitemap reference -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Organization schema (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PielSmart",
      "url": "https://pielsmart.com",
      "logo": "https://pielsmart.com/favicon.svg",
      "description": "Guías y reseñas de belleza. Skincare, maquillaje, cabello, uñas y perfumes.",
      "sameAs": [
        "https://www.pinterest.com/fredpreci95"
      ]
    })} />

    <!-- Google Analytics 4 — loaded only after cookie consent -->
    <script is:inline>
      (function() {
        function loadGA4() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-SL7FT6Y126';
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-SL7FT6Y126');
        }
        if (localStorage.getItem('ps_cookie_consent') === 'accepted') {
          loadGA4();
        }
        window.__loadGA4 = loadGA4;
      })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" /></noscript>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script define:vars={{ articlesJson }}>
      window.__PS_ARTICLES__ = JSON.parse(articlesJson);
    </script>
    <button class="back-to-top" id="backToTop" aria-label="Volver arriba" hidden>↑</button>
    <script is:inline>
      (function() {
        var btn = document.getElementById('backToTop');
        if (!btn) return;
        window.addEventListener('scroll', function() { btn.hidden = window.scrollY < 400; }, { passive: true });
        btn.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      })();
    </script>

    <!-- Cookie consent banner -->
    <div id="cookie-banner" role="dialog" aria-label="Aviso de cookies" aria-live="polite">
      <p class="cb-text">
        Usamos cookies de análisis (Google Analytics) para mejorar el sitio.
        <a href="/privacidad/" class="cb-link">Más información</a>.
      </p>
      <div class="cb-actions">
        <button id="cookie-reject" class="cb-btn cb-btn--reject">Rechazar</button>
        <button id="cookie-accept" class="cb-btn cb-btn--accept">Aceptar</button>
      </div>
    </div>
    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-banner');
        var consent = localStorage.getItem('ps_cookie_consent');
        if (consent) { banner.hidden = true; return; }
        banner.hidden = false;
        document.getElementById('cookie-accept').addEventListener('click', function() {
          localStorage.setItem('ps_cookie_consent', 'accepted');
          banner.hidden = true;
          if (window.__loadGA4) window.__loadGA4();
        });
        document.getElementById('cookie-reject').addEventListener('click', function() {
          localStorage.setItem('ps_cookie_consent', 'rejected');
          banner.hidden = true;
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  #cookie-banner {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 2.5rem);
    max-width: 580px;
    background: #1a1a2e;
    color: #e8e8e8;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.25);
    z-index: 999;
    font-family: 'DM Sans', sans-serif;
    flex-wrap: wrap;
  }
  #cookie-banner[hidden] { display: none; }
  .cb-text {
    font-size: 0.83rem;
    margin: 0;
    line-height: 1.5;
    flex: 1;
    min-width: 200px;
  }
  .cb-link { color: #e07b39; }
  .cb-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .cb-btn {
    font-size: 0.8rem;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .cb-btn--reject {
    background: transparent;
    color: #aaa;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .cb-btn--reject:hover { color: #fff; border-color: rgba(255,255,255,0.35); }
  .cb-btn--accept {
    background: #e07b39;
    color: #fff;
  }
  .cb-btn--accept:hover { background: #c4693a; }
</style>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #2d2d2d;
    background: #fff;
    line-height: 1.75;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }

  h1, h2, h3, h4 {
    font-family: 'Playfair Display', Georgia, serif;
    line-height: 1.25;
    margin-top: 0;
    color: #1a1a2e;
  }

  a { color: #c4693a; }

  img { max-width: 100%; height: auto; }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .back-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #1a1a2e;
    color: #fff;
    border: none;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0,0,0,0.2);
    z-index: 90;
    transition: background 0.15s, transform 0.15s;
  }
  .back-to-top:hover { background: #c4693a; transform: translateY(-2px); }
  .back-to-top[hidden] { display: none; }
</style>
