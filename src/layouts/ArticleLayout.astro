---
import BaseLayout from './BaseLayout.astro';

interface RelatedArticle {
  title: string;
  slug: string;
  pillar: string;
  image?: string;
}

interface Props {
  title: string;
  description: string;
  pillar: 'skincare' | 'maquillaje' | 'cabello' | 'unas' | 'perfumes' | 'dispositivos';
  datePublished: string;
  dateModified?: string;
  targetKeyword: string;
  image?: string;
  relatedArticles?: RelatedArticle[];
}

const {
  title,
  description,
  pillar,
  datePublished,
  dateModified,
  targetKeyword,
  image,
  relatedArticles,
} = Astro.props;

const pillarColors: Record<string, string> = {
  skincare: '#7DB9A8',
  maquillaje: '#C4728A',
  cabello: '#C9A35E',
  unas: '#9B7EC8',
  perfumes: '#C47898',
  dispositivos: '#5E9EC4',
};

const pillarNames: Record<string, string> = {
  skincare: 'Skincare',
  maquillaje: 'Maquillaje',
  cabello: 'Cabello',
  unas: 'Uñas',
  perfumes: 'Perfumes',
  dispositivos: 'Dispositivos',
};

const pillarName = pillarNames[pillar];

function formatDateSpanish(isoDate: string): string {
  const [year, month, day] = isoDate.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  return date.toLocaleDateString('es-419', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const formattedDate = formatDateSpanish(datePublished);

const canonicalUrl = `https://pielsmart.com/${pillar}/${Astro.url.pathname.split('/').filter(Boolean).pop()}/`;

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished,
  dateModified: dateModified ?? datePublished,
  author: { '@type': 'Organization', name: 'PielSmart', url: 'https://pielsmart.com' },
  publisher: {
    '@type': 'Organization',
    name: 'PielSmart',
    url: 'https://pielsmart.com',
    logo: { '@type': 'ImageObject', url: 'https://pielsmart.com/favicon.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  keywords: targetKeyword,
  inLanguage: 'es-419',
};
if (image) {
  articleSchema.image = {
    '@type': 'ImageObject',
    url: image,
    width: 1200,
    height: 630,
  };
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pielsmart.com/' },
    { '@type': 'ListItem', position: 2, name: pillarName, item: `https://pielsmart.com/${pillar}/` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<BaseLayout title={title} description={description} ogImage={image} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="article-page">
    {image && (
      <div class="article-hero-img">
        <img src={`${image}?auto=compress&cs=tinysrgb&w=1200&h=500&fit=crop`} alt={title} />
      </div>
    )}
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href={`/${pillar}/`}>{pillarName}</a>
      <span>/</span>
      <span>{title}</span>
    </nav>

    <header class="article-header">
      <h1>{title}</h1>
      <p class="article-meta">
        Publicado el <time datetime={datePublished}>{formattedDate}</time>
        {dateModified && dateModified !== datePublished && (
          <> · Actualizado el <time datetime={dateModified}>{formatDateSpanish(dateModified)}</time></>
        )}
        {' '}· PielSmart
      </p>
    </header>

    <div class="article-body">
      <slot />
    </div>

    {relatedArticles && relatedArticles.length > 0 && (
      <div class="related-section">
        <h2 class="related-title">Sigue leyendo</h2>
        <div class="related-grid">
          {relatedArticles.map(article => (
            <a href={`/${article.pillar}/${article.slug}/`} class="related-card">
              {article.image && (
                <div class="related-img-wrap">
                  <img src={`${article.image}?auto=compress&cs=tinysrgb&w=600&h=300&fit=crop`} alt={article.title} class="related-img" loading="lazy" />
                </div>
              )}
              <div class="related-body">
                <span class="related-tag" style={`color:${pillarColors[article.pillar]}`}>{article.pillar.charAt(0).toUpperCase() + article.pillar.slice(1)}</span>
                <p class="related-card-title">{article.title}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="cta-box">
      <span class="cta-icon">🛍️</span>
      <div class="cta-text">
        <strong>¿Lista para comprar?</strong>
        <a href="https://www.amazon.com/?tag=pielsmart-20" target="_blank" rel="noopener sponsored">
          Encuentra los mejores productos en Amazon →
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-hero-img {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 460px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }
  .article-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-page {
    max-width: 760px;
    margin: 0 auto;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 1.25rem;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: #6b7280;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: #e07b39;
  }
  .breadcrumb span:not(:last-child) {
    color: #9ca3af;
  }

  .article-header {
    margin-bottom: 2rem;
  }
  .article-header h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: #1a1a2e;
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }
  .article-meta {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }

  .article-body {
    color: #374151;
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .article-body h2 {
    font-size: 1.45rem;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    color: #1a1a2e;
    border-top: 3px solid #1a1a2e;
    padding-top: 1.5rem;
  }
  .article-body h3 {
    font-size: 1.15rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: #1a1a2e;
  }
  .article-body p {
    margin-bottom: 1.25rem;
  }
  .article-body ul,
  .article-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-body li {
    margin-bottom: 0.4rem;
  }
  .article-body a {
    color: #e07b39;
  }

  .related-section {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e8e8e8;
  }
  .related-title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #999;
    font-family: 'DM Sans', sans-serif;
    margin-bottom: 1.25rem;
    border-top: none !important;
    padding-top: 0 !important;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
  }
  .related-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
  .related-img-wrap { width: 100%; height: 160px; overflow: hidden; }
  .related-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .related-body { padding: 0.875rem; }
  .related-tag { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .related-card-title { font-size: 0.95rem; font-weight: 600; color: #1a1a2e; margin: 0.35rem 0 0; line-height: 1.4; font-family: 'Playfair Display', Georgia, serif; }
  @media (max-width: 520px) { .related-grid { grid-template-columns: 1fr; } }

  .cta-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #fff8f3;
    border: 2px solid #e07b39;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-top: 3rem;
  }
  .cta-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }
  .cta-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cta-text strong {
    font-size: 1rem;
    color: #1a1a2e;
  }
  .cta-text a {
    color: #e07b39;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .cta-text a:hover {
    text-decoration: underline;
  }
</style>
